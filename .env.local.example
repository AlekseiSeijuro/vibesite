# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# RouterAI (https://routerai.ru/settings/keys)
ROUTERAI_API_KEY=your_routerai_api_key_here
# Модель для генерации сайтов. Можно менять без изменения кода.
# Список моделей: https://routerai.ru/models
# Примеры: anthropic/claude-sonnet-4-5, anthropic/claude-opus-4-5,
#          openai/gpt-4o, google/gemini-pro
ROUTERAI_MODEL=anthropic/claude-sonnet-4-5

# Yandex Cloud S3
YC_S3_ACCESS_KEY=your_yc_s3_access_key
YC_S3_SECRET_KEY=your_yc_s3_secret_key
YC_S3_BUCKET_NAME=vibesite-storage
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_REGION=ru-central1

# YooKassa
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=vibesite.ru

# Яндекс.Метрика
NEXT_PUBLIC_YM_ID=11111111
